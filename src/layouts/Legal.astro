---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  updated: string;
}
const { title, description, updated } = Astro.props;
---

<Base title={title} description={description}>
  <article class="container-x max-w-[820px] pb-24 pt-14 md:pt-20">
    <p class="eyebrow">Legal</p>
    <h1 class="mt-4 text-[38px] font-semibold tracking-[-0.03em] sm:text-[48px]">{title}</h1>
    <p class="mt-3 text-[14px] text-ink-mute">Last updated {updated}</p>
    <div class="prose-aicmo mt-10">
      <slot />
    </div>
  </article>
</Base>
