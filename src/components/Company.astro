---
import { SITE, url } from '../lib/site';
const c = SITE.company;
---

<section class="container-x py-16" aria-labelledby="company-heading">
  <div class="mx-auto flex max-w-[880px] flex-col gap-5 rounded-[28px] border border-line bg-paper-2/60 p-8 sm:flex-row sm:items-center sm:gap-8 sm:p-10">
    <div class="flex-1">
      <p class="eyebrow">Who's behind AdMobot</p>
      <h2 id="company-heading" class="mt-3 text-[24px] font-semibold tracking-[-0.02em]">
        AdMobot is built and managed by <a href={c.url} rel="noopener" class="text-brand underline-offset-4 hover:underline">{c.name}</a>
      </h2>
      <p class="mt-3 text-[15px] leading-relaxed text-ink-soft">
        {c.name} is an independent software studio in {SITE.country} that designs, builds and supports its products in-house. It runs AdMobot,
        handles billing and support, and is the business you contract with when you subscribe.
      </p>
    </div>
    <div class="flex shrink-0 flex-col gap-2 text-[14px]">
      <a href={c.url} rel="noopener" class="font-semibold text-ink hover:text-brand">tharuntechsolutions.in ↗</a>
      <a href={url('/contact')} class="text-ink-mute hover:text-ink">Contact us</a>
      <a href={url('/refund-policy')} class="text-ink-mute hover:text-ink">Cancellation &amp; refunds</a>
    </div>
  </div>
</section>
