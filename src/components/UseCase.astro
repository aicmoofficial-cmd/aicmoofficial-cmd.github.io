---
import Company from './Company.astro';
import Base from '../layouts/Base.astro';
import EarlyAccess from './EarlyAccess.astro';
import Faq from './Faq.astro';
import { url } from '../lib/site';

interface Props {
  seoTitle: string;
  seoDescription: string;
  eyebrow: string;
  title: string;
  accent: string;
  intro: string;
  pains: [string, string][];
  capabilities: [string, string][];
  week: [string, string][];
  faq: { q: string; a: string }[];
  related: [string, string][];
  source: string;
}
const p = Astro.props;
const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: p.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL(url('/'), Astro.site).href },
      { '@type': 'ListItem', position: 2, name: p.eyebrow, item: new URL(Astro.url.pathname, Astro.site).href },
    ],
  },
];
---

<Base title={p.seoTitle} description={p.seoDescription} jsonLd={ld}>
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-[460px] bg-[radial-gradient(60%_60%_at_30%_0%,rgb(155_77_255/0.10),transparent_70%)]"></div>
    <div class="container-x relative pb-20 pt-16 md:pb-28 md:pt-24">
      <p class="eyebrow">{p.eyebrow}</p>
      <h1 class="mt-5 max-w-4xl text-[42px] font-semibold leading-[1.04] tracking-[-0.035em] sm:text-[62px]">
        {p.title} <span class="serif-accent text-brand">{p.accent}</span>
      </h1>
      <p class="mt-6 max-w-2xl text-[18.5px] leading-relaxed text-ink-soft">{p.intro}</p>
      <div class="mt-9"><EarlyAccess source={p.source} /></div>
    </div>
  </section>

  <section class="container-x pb-24">
    <div class="grid gap-5 md:grid-cols-3">
      {
        p.pains.map(([t, b]) => (
          <div class="card p-7" data-reveal>
            <h2 class="text-[18px] font-semibold">{t}</h2>
            <p class="mt-2 text-[15px] leading-relaxed text-ink-mute">{b}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="bg-ink text-white">
    <div class="container-x grid gap-14 py-24 md:py-28 lg:grid-cols-[0.85fr_1.15fr]">
      <div data-reveal>
        <p class="eyebrow !text-sky">What AdMobot does for you</p>
        <h2 class="mt-4 text-[34px] font-semibold leading-tight tracking-[-0.03em] sm:text-[44px]">
          Built around <span class="serif-accent text-brand">how you actually work.</span>
        </h2>
      </div>
      <div class="grid gap-px overflow-hidden rounded-[24px] bg-white/10 sm:grid-cols-2">
        {
          p.capabilities.map(([t, b]) => (
            <div class="bg-ink p-7" data-reveal>
              <h3 class="text-[17px] font-semibold">{t}</h3>
              <p class="mt-2 text-[14.5px] leading-relaxed text-white/60">{b}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="container-x py-24 md:py-28">
    <div class="mx-auto max-w-3xl">
      <p class="eyebrow">A week with AdMobot</p>
      <h2 class="mt-4 text-[32px] font-semibold tracking-[-0.03em] sm:text-[40px]">What it looks like in practice</h2>
      <ol class="mt-10 space-y-0 border-l border-line">
        {
          p.week.map(([day, text]) => (
            <li class="relative pb-9 pl-8 last:pb-0" data-reveal>
              <span class="absolute -left-[7px] top-1.5 h-3.5 w-3.5 rounded-full border-2 border-paper bg-brand" />
              <p class="text-[13px] font-semibold uppercase tracking-wider text-royal">{day}</p>
              <p class="mt-1.5 text-[16.5px] leading-relaxed text-ink-soft">{text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="bg-paper-2/70">
    <div class="container-x grid gap-12 py-24 lg:grid-cols-[0.8fr_1.2fr]">
      <div>
        <h2 class="text-[32px] font-semibold leading-tight tracking-[-0.03em] sm:text-[40px]">Questions</h2>
        <ul class="mt-6 space-y-2 text-[15px]">
          {p.related.map(([label, href]) => <li><a class="text-royal underline underline-offset-4" href={url(href)}>{label}</a></li>)}
        </ul>
      </div>
      <Faq items={p.faq} />
    </div>
  </section>

  <section class="container-x py-24 text-center">
    <h2 class="text-[32px] font-semibold tracking-[-0.03em] sm:text-[44px]">Let AdMobot take the first week.</h2>
    <p class="mx-auto mt-4 max-w-md text-[17px] text-ink-soft">Plans from ₹1,999/month. 7-day trial. You approve every post.</p>
    <div class="mt-8 flex justify-center"><EarlyAccess source={`${p.source}-bottom`} /></div>
  </section>
  <Company />
</Base>
