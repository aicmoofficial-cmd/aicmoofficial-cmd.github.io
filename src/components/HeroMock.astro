---
// Illustration of the daily CMO briefing across the marketing loop (a fictional brand; no real metrics).
const rail = ['Research', 'Analyze', 'Plan', 'Create', 'Publish', 'Measure', 'Compare'];
---

<div class="relative mx-auto mb-16 w-full max-w-[580px] sm:mb-10" aria-hidden="true">
  <div class="glow left-[-10%] top-[10%] h-64 w-64 bg-violet"></div>
  <div class="glow right-[-8%] bottom-[5%] h-64 w-64 bg-sky"></div>

  <div class="card relative overflow-hidden !rounded-[28px]">
    <div class="flex items-center justify-between border-b border-line bg-paper/70 px-5 py-3">
      <div class="flex gap-1.5">
        <span class="h-2.5 w-2.5 rounded-full bg-[#ff6159]"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-[#ffbd2e]"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-[#28c941]"></span>
      </div>
      <span class="hidden text-[12px] font-semibold text-ink-mute sm:inline">Kaya Handloom · Today's briefing</span>
      <span class="w-10"></span>
    </div>

    <div class="grid sm:grid-cols-[124px_1fr]">
      <!-- Stage rail -->
      <ul class="hidden border-r border-line bg-paper/40 p-3 sm:block">
        {
          rail.map((r, i) => (
            <li class={`mb-1 flex items-center gap-2 rounded-xl px-2.5 py-2 text-[12px] font-semibold ${i === 3 ? 'bg-white text-ink shadow-sm' : 'text-ink-mute'}`}>
              <span class={`h-1.5 w-1.5 rounded-full ${i === 3 ? 'bg-brand' : 'bg-line'}`} />
              {r}
            </li>
          ))
        }
      </ul>

      <!-- Briefing feed -->
      <div class="space-y-2.5 p-4">
        <div class="rounded-2xl border border-line bg-white p-3">
          <p class="text-[10px] font-bold uppercase tracking-wider text-sky">Research</p>
          <p class="mt-1 text-[13px] font-semibold leading-snug">A competitor changed its pricing page</p>
          <p class="text-[11.5px] text-ink-mute">New free-shipping threshold spotted overnight</p>
        </div>

        <div class="rounded-2xl border border-line bg-white p-3">
          <p class="text-[10px] font-bold uppercase tracking-wider text-violet">Analyze</p>
          <p class="mt-1 text-[13px] font-semibold leading-snug">Reviews keep praising the fabric, asking about sizing</p>
          <p class="text-[11.5px] text-ink-mute">Suggested: a size-guide carousel this week</p>
        </div>

        <!-- Create: post awaiting approval -->
        <div class="rounded-2xl border-2 border-royal/25 bg-white p-3">
          <p class="text-[10px] font-bold uppercase tracking-wider text-royal">Create · Ready for you</p>
          <div class="mt-2 flex gap-3">
            <div class="relative h-[86px] w-[70px] shrink-0 overflow-hidden rounded-xl bg-[#1f2a6b]">
              <svg viewBox="0 0 70 86" class="absolute inset-0 h-full w-full">
                <defs>
                  <pattern id="blockprint" width="22" height="22" patternUnits="userSpaceOnUse">
                    <circle cx="11" cy="11" r="4" fill="none" stroke="#c9d3ff" stroke-width="1" opacity=".6"></circle>
                    <path d="M11 3 L13 8 L11 11 L9 8Z M11 19 L13 14 L11 11 L9 14Z M3 11 L8 9 L11 11 L8 13Z M19 11 L14 9 L11 11 L14 13Z" fill="#e8ecff" opacity=".4"></path>
                  </pattern>
                </defs>
                <rect width="70" height="86" fill="url(#blockprint)"></rect>
              </svg>
              <span class="absolute inset-x-1.5 bottom-1.5 rounded-md bg-white/90 px-1 py-0.5 text-center text-[8.5px] font-bold text-[#1f2a6b]">₹1,499</span>
            </div>
            <div class="min-w-0 flex-1">
              <p class="text-[12px] font-semibold">Instagram · Carousel</p>
              <p class="mt-0.5 line-clamp-2 text-[12px] leading-snug text-ink-soft">Every motif on this kurta was stamped by hand in Bagru. Natural indigo, soft cotton.</p>
              <div class="mt-2 flex gap-1.5">
                <span class="rounded-full bg-ink px-3 py-1 text-[11px] font-semibold text-white">Approve</span>
                <span class="rounded-full bg-emerald-50 px-2 py-1 text-[10.5px] font-semibold text-emerald-700">✓ Price checked</span>
              </div>
            </div>
          </div>
        </div>

        <div class="rounded-2xl border border-line bg-white p-3">
          <div class="flex items-end justify-between gap-3">
            <div>
              <p class="text-[10px] font-bold uppercase tracking-wider text-emerald-600">Measure</p>
              <p class="mt-1 text-[13px] font-semibold leading-snug">Saves are up on craft-story posts</p>
              <p class="text-[11.5px] text-ink-mute">Doing more of these next week</p>
            </div>
            <div class="flex h-10 items-end gap-1">
              {[40, 55, 35, 70, 60, 90].map((h) => <span class="w-2 rounded-sm bg-gradient-to-t from-royal to-violet" style={`height:${h}%`} />)}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Floating: publish -->
  <div class="card absolute -right-3 -top-5 flex items-center gap-2.5 !rounded-2xl px-3.5 py-2.5 sm:-right-8">
    <span class="grid h-8 w-8 place-items-center rounded-xl bg-brand text-white">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><rect x="3" y="5" width="18" height="16" rx="3"></rect><path d="M8 3v4M16 3v4M3 10h18"></path></svg>
    </span>
    <div class="leading-tight">
      <p class="text-[12px] font-semibold">Scheduled on 3 channels</p>
      <p class="text-[11px] text-ink-mute">Fri · 7:30 PM IST</p>
    </div>
  </div>

  <!-- Floating: CMO chat -->
  <div class="card absolute -bottom-24 left-4 max-w-[270px] !rounded-2xl p-3.5 sm:-bottom-20 sm:-left-8">
    <p class="text-[11px] font-semibold uppercase tracking-wider text-ink-mute">You → your AI CMO</p>
    <p class="mt-1.5 text-[13px] font-medium leading-snug">“Plan next week around our summer collection.”</p>
    <p class="mt-2 flex items-center gap-1.5 text-[12px] text-emerald-700">
      <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span> Plan + 7 posts ready for review
    </p>
  </div>
</div>
