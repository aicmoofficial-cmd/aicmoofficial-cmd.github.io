---
// Illustration of the approval flow (a fictional brand; no real metrics).
---

<div class="relative mx-auto mb-16 w-full max-w-[560px] sm:mb-10" aria-hidden="true">
  <div class="glow left-[-10%] top-[10%] h-64 w-64 bg-violet"></div>
  <div class="glow right-[-8%] bottom-[5%] h-64 w-64 bg-sky"></div>

  <!-- App window -->
  <div class="card relative overflow-hidden !rounded-[28px]">
    <div class="flex items-center justify-between border-b border-line bg-paper/70 px-5 py-3">
      <div class="flex gap-1.5">
        <span class="h-2.5 w-2.5 rounded-full bg-[#ff6159]"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-[#ffbd2e]"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-[#28c941]"></span>
      </div>
      <span class="hidden text-[12px] font-semibold text-ink-mute sm:inline">Approval inbox · 3 waiting</span>
      <span class="w-10"></span>
    </div>

    <div class="grid gap-5 p-5 sm:grid-cols-[200px_1fr]">
      <!-- Product photo card -->
      <div class="overflow-hidden rounded-2xl border border-line">
        <div class="relative aspect-[4/5] bg-[#1f2a6b]">
          <svg viewBox="0 0 200 250" class="absolute inset-0 h-full w-full opacity-90">
            <defs>
              <pattern id="blockprint" width="40" height="40" patternUnits="userSpaceOnUse">
                <circle cx="20" cy="20" r="7" fill="none" stroke="#c9d3ff" stroke-width="1.4" opacity=".55"></circle>
                <path d="M20 6 L23 13 L20 20 L17 13Z M20 34 L23 27 L20 20 L17 27Z M6 20 L13 17 L20 20 L13 23Z M34 20 L27 17 L20 20 L27 23Z" fill="#e8ecff" opacity=".35"></path>
                <circle cx="0" cy="0" r="2" fill="#e8ecff" opacity=".4"></circle>
                <circle cx="40" cy="40" r="2" fill="#e8ecff" opacity=".4"></circle>
              </pattern>
              <linearGradient id="fade" x1="0" y1="0" x2="0" y2="1">
                <stop offset=".55" stop-color="#1f2a6b" stop-opacity="0"></stop>
                <stop offset="1" stop-color="#0f153d" stop-opacity=".95"></stop>
              </linearGradient>
            </defs>
            <rect width="200" height="250" fill="url(#blockprint)"></rect>
            <rect width="200" height="250" fill="url(#fade)"></rect>
          </svg>
          <span class="absolute left-3 top-3 rounded-full bg-white/90 px-2.5 py-1 text-[10px] font-bold text-[#1f2a6b]">NEW DROP</span>
          <div class="absolute inset-x-3 bottom-3 text-white">
            <p class="text-[13px] font-semibold leading-tight">Indigo block-print kurta</p>
            <p class="mt-1 text-[12px] font-medium text-white/80">₹1,499 · Kaya Handloom</p>
          </div>
        </div>
      </div>

      <!-- Post -->
      <div class="flex min-w-0 flex-col">
        <div class="flex items-center gap-2">
          <span class="grid h-7 w-7 place-items-center rounded-full bg-gradient-to-br from-[#f58529] via-[#dd2a7b] to-[#8134af] text-[10px] font-bold text-white">IG</span>
          <div class="leading-tight">
            <p class="text-[13px] font-semibold">Instagram · Carousel</p>
            <p class="text-[11px] text-ink-mute">Pillar: Craft stories</p>
          </div>
        </div>
        <p class="mt-3 text-[13.5px] leading-relaxed text-ink-soft">
          Every motif on this kurta was stamped by hand in Bagru. Soft cotton, natural indigo, made for long summer days. <span class="text-royal">#handloom #slowfashion</span>
        </p>
        <div class="mt-3 flex flex-wrap gap-1.5">
          <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-[11px] font-semibold text-emerald-700">✓ Price matches catalogue</span>
          <span class="rounded-full bg-indigo-50 px-2.5 py-1 text-[11px] font-semibold text-royal">On-brand</span>
        </div>
        <div class="mt-auto flex gap-2 pt-4">
          <span class="flex-1 rounded-full bg-ink py-2 text-center text-[12.5px] font-semibold text-white">Approve</span>
          <span class="flex-1 rounded-full border border-line py-2 text-center text-[12.5px] font-semibold">Edit</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Floating: schedule -->
  <div class="card absolute -right-3 -top-5 flex items-center gap-2.5 !rounded-2xl px-3.5 py-2.5 sm:-right-8">
    <span class="grid h-8 w-8 place-items-center rounded-xl bg-brand text-white">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><rect x="3" y="5" width="18" height="16" rx="3"></rect><path d="M8 3v4M16 3v4M3 10h18"></path></svg>
    </span>
    <div class="leading-tight">
      <p class="text-[12px] font-semibold">Scheduled</p>
      <p class="text-[11px] text-ink-mute">Fri · 7:30 PM IST</p>
    </div>
  </div>

  <!-- Floating: CMO chat -->
  <div class="card absolute -bottom-24 left-4 max-w-[270px] !rounded-2xl p-3.5 sm:-bottom-20 sm:-left-8">
    <p class="text-[11px] font-semibold uppercase tracking-wider text-ink-mute">You → your AI CMO</p>
    <p class="mt-1.5 text-[13px] font-medium leading-snug">“Plan next week around our summer collection.”</p>
    <p class="mt-2 flex items-center gap-1.5 text-[12px] text-emerald-700">
      <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span> 7 posts drafted for review
    </p>
  </div>
</div>
