---
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

<div class="divide-y divide-line border-y border-line">
  {
    items.map((it) => (
      <details class="group py-5">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-[17px] font-medium [&::-webkit-details-marker]:hidden">
          {it.q}
          <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full border border-line transition-transform group-open:rotate-45">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
          </span>
        </summary>
        <p class="mt-3 max-w-3xl pr-12 text-[15.5px] leading-relaxed text-ink-soft">{it.a}</p>
      </details>
    ))
  }
</div>
