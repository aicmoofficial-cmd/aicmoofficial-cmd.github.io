---
import { SITE, url } from '../lib/site';

const cols = [
  {
    title: 'Product',
    links: [
      ['Platform', url('/platform')],
      ['How it works', url('/#how')],
      ['Pricing', url('/pricing')],
      [SITE.signupOpen ? 'Start free trial' : 'Early access', url('/#early-access')],
    ],
  },
  {
    title: 'Built for',
    links: [
      ['D2C & Shopify brands', url('/for/d2c-brands')],
      ['Startups & apps', url('/for/startups')],
      ['Agencies', url('/for/agencies')],
    ],
  },
  {
    title: 'Resources',
    links: [
      ['Blog', url('/blog')],
      ['AI CMO vs agency vs freelancer', url('/blog/ai-cmo-vs-agency-vs-freelancer')],
      ['30-day content plan', url('/blog/30-day-social-media-content-plan-for-startups')],
    ],
  },
  {
    title: 'Company',
    links: [
      ['Contact us', url('/contact')],
      ['Privacy policy', url('/privacy')],
      ['Terms of service', url('/terms')],
      ['Cancellation & refunds', url('/refund-policy')],
      ['Service delivery', url('/delivery-policy')],
      ['Data deletion', url('/data-deletion')],
    ],
  },
];
const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-paper-2/60">
  <div class="container-x grid gap-12 py-16 md:grid-cols-[1.4fr_repeat(4,1fr)]">
    <div class="max-w-xs">
      <a href={url('/')} class="flex items-center gap-2.5">
        <img src={url('/logo-mark.png')} alt="" width="28" height="28" class="h-7 w-7 object-contain" loading="lazy" />
        <span class="text-[17px] font-bold tracking-tight">Ad<span class="text-brand">Mobot</span></span>
      </a>
      <p class="mt-4 text-[14px] leading-relaxed text-ink-mute">
        Your complete AI marketing team: research, strategy, content, publishing and analytics in one place. Made in India.
      </p>
    </div>
    {
      cols.map((c) => (
        <div>
          <h2 class="text-[13px] font-semibold text-ink">{c.title}</h2>
          <ul class="mt-4 space-y-3">
            {c.links.map(([label, href]) => (
              <li>
                <a href={href} class="text-[14px] text-ink-mute transition-colors hover:text-ink">
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div class="container-x flex flex-col gap-2 border-t border-line py-6 text-[13px] text-ink-mute sm:flex-row sm:items-center sm:justify-between">
    <span>
      © {year} {SITE.legalName}. All rights reserved. AdMobot is built and managed by
      <a href={SITE.company.url} rel="noopener" class="underline underline-offset-2 hover:text-ink">{SITE.company.name}</a>.
    </span>
    <span>Prices in INR, exclusive of GST.</span>
  </div>
</footer>
