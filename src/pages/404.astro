---
import Base from '../layouts/Base.astro';
import { url } from '../lib/site';
---

<Base title="Page not found" noindex>
  <section class="container-x py-32 text-center">
    <p class="font-serif text-[96px] italic leading-none text-brand">404</p>
    <h1 class="mt-6 text-[32px] font-semibold tracking-[-0.03em]">This page took a day off.</h1>
    <p class="mt-3 text-[17px] text-ink-soft">Your AI CMO never does, though.</p>
    <div class="mt-8 flex justify-center gap-3">
      <a href={url('/')} class="btn-primary">Go home</a>
      <a href={url('/blog')} class="btn-secondary">Read the blog</a>
    </div>
  </section>
</Base>
