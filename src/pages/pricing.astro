---
import Base from '../layouts/Base.astro';
import PricingCards from '../components/PricingCards.astro';
import Faq from '../components/Faq.astro';
import EarlyAccess from '../components/EarlyAccess.astro';
import { CREDIT_COSTS, PLANS, SITE } from '../lib/site';
import { FAQ } from '../lib/faq';

const faq = FAQ.filter((f) => /credits|trial|cancel|post things/i.test(f.q));
const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: `${SITE.name} subscription`,
    description: SITE.description,
    brand: { '@type': 'Brand', name: SITE.name },
    offers: {
      '@type': 'AggregateOffer',
      priceCurrency: 'INR',
      lowPrice: Math.min(...PLANS.map((p) => p.price)),
      highPrice: Math.max(...PLANS.map((p) => p.price)),
      offerCount: PLANS.length,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<Base
  title="Pricing — plans from ₹999/month"
  description="AICMO pricing: Starter ₹999, Growth ₹2,499 and Pro ₹5,999 a month. 7-day trial, card or UPI Autopay, cancel anytime. See what credits cover."
  jsonLd={ld}
>
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-[420px] bg-[radial-gradient(60%_60%_at_50%_0%,rgb(61_61_245/0.10),transparent_70%)]"></div>
    <div class="container-x relative pb-20 pt-16 md:pt-24">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">Pricing</p>
        <h1 class="mt-4 text-[42px] font-semibold leading-[1.05] tracking-[-0.035em] sm:text-[60px]">
          A marketing team <span class="serif-accent text-brand">for less than lunch money.</span>
        </h1>
        <p class="mt-5 text-[18px] leading-relaxed text-ink-soft">
          Start with a 7-day trial of Growth. Pay monthly or yearly by card or UPI Autopay, in rupees. Prices exclude GST.
        </p>
      </div>
      <div class="mt-16">
        <PricingCards />
      </div>
    </div>
  </section>

  <section class="container-x pb-24">
    <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <p class="eyebrow">Credits</p>
        <h2 class="mt-4 text-[32px] font-semibold leading-tight tracking-[-0.03em] sm:text-[40px]">
          Pay for the work, <span class="serif-accent">not for clicks.</span>
        </h2>
        <p class="mt-4 text-[16.5px] leading-relaxed text-ink-soft">
          Each plan includes credits every month. Writing costs credits; everything that keeps your marketing running — publishing, analytics, fact checks, product photo cards — is free.
        </p>
        <ul class="mt-6 space-y-2 text-[15px] text-ink-soft">
          <li>• Need more? Top up 100 credits for ₹499. Top-ups last 12 months.</li>
          <li>• Out of credits? Scheduled posts still go out; new writing pauses until you top up or your plan renews.</li>
          <li>• Extra brand on any plan: ₹999/month.</li>
        </ul>
      </div>
      <div class="card overflow-hidden">
        <table class="w-full text-left text-[15px]">
          <thead>
            <tr class="border-b border-line bg-paper-2/60">
              <th class="p-4 pl-6 font-semibold">Action</th>
              <th class="p-4 pr-6 text-right font-semibold">Credits</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            {
              CREDIT_COSTS.map(([a, c]) => (
                <tr>
                  <td class="p-4 pl-6 text-ink-soft">{a}</td>
                  <td class={`p-4 pr-6 text-right font-semibold ${c === 'Free' ? 'text-emerald-700' : ''}`}>{c}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-paper-2/70">
    <div class="container-x grid gap-12 py-24 lg:grid-cols-[0.8fr_1.2fr]">
      <h2 class="text-[32px] font-semibold leading-tight tracking-[-0.03em] sm:text-[40px]">Billing questions</h2>
      <Faq items={faq} />
    </div>
  </section>

  <section id="early-access" class="container-x scroll-mt-24 py-24 text-center">
    <h2 class="text-[32px] font-semibold tracking-[-0.03em] sm:text-[44px]">Ready when you are.</h2>
    <p class="mx-auto mt-4 max-w-md text-[17px] text-ink-soft">Join early access and we'll send your invite with a 7-day trial.</p>
    <div class="mt-8 flex justify-center"><EarlyAccess source="pricing" /></div>
  </section>
</Base>
