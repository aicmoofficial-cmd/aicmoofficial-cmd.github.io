---
import Company from '../components/Company.astro';
import Base from '../layouts/Base.astro';
import HeroMock from '../components/HeroMock.astro';
import EarlyAccess from '../components/EarlyAccess.astro';
import PricingCards from '../components/PricingCards.astro';
import Faq from '../components/Faq.astro';
import { CHANNELS, PLANS, SITE, url } from '../lib/site';
import { FAQ } from '../lib/faq';
import { COMING_NEXT, STAGES } from '../lib/platform';

const tones = ['text-sky', 'text-violet', 'text-royal', 'text-royal', 'text-violet', 'text-emerald-600', 'text-sky'];

const modes = [
  {
    name: 'Suggest only',
    body: 'AdMobot drafts, you decide what happens to each post. Nothing is scheduled without you.',
    tag: 'Full control',
  },
  {
    name: 'Ask before posting',
    body: 'Posts are written, designed and scheduled, then wait in your inbox for a one-tap approval.',
    tag: 'Recommended to start',
  },
  {
    name: 'Full autopilot',
    body: 'Posts that clear your brand-score bar and the fact check publish on their own. Anything unsure still comes to you.',
    tag: 'When you trust it',
  },
];

const compare = [
  ['Researches your market and competitors', 'yes', 'yes', 'Sometimes', 'Research tool'],
  ['Analyzes reviews and customer feedback', 'yes', 'Sometimes', 'no', 'Another tool'],
  ['Plans strategy and campaigns', 'yes', 'yes', 'Sometimes', 'You do it'],
  ['Creates posts, images and documents', 'yes', 'yes', 'yes', 'Design + AI tools'],
  ['Publishes on schedule', 'yes', 'yes', 'yes', 'Scheduler'],
  ['Checks facts before posting', 'yes', 'Depends', 'Depends', 'no'],
  ['Measures clicks, installs and engagement', 'yes', 'Monthly report', 'Rarely', 'Analytics tool'],
  ['Runs and compares experiments', 'yes', 'Sometimes', 'no', 'Spreadsheet'],
  ['Available', '24 × 7', 'Office hours', 'When free', 'When you are'],
  ['Monthly cost', 'From ₹1,499', 'Retainer', 'Retainer', 'Several subscriptions'],
];

const softwareLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: SITE.name,
  url: new URL(url('/'), Astro.site).href,
  image: new URL(url('/og.png'), Astro.site).href,
  applicationCategory: 'BusinessApplication',
  applicationSubCategory: 'Marketing automation',
  operatingSystem: 'Web, Android',
  description: SITE.description,
  inLanguage: 'en-IN',
  publisher: { '@id': new URL(url('/#organization'), Astro.site).href },
  featureList: STAGES.flatMap((s) => s.tools.map(([t]) => t)),
  offers: PLANS.map((p) => ({
    '@type': 'Offer',
    name: p.name,
    price: p.price,
    priceCurrency: 'INR',
    category: 'subscription',
    url: new URL(url('/pricing'), Astro.site).href,
  })),
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: new URL(url('/'), Astro.site).href,
  inLanguage: 'en-IN',
  publisher: { '@id': new URL(url('/#organization'), Astro.site).href },
};
---

<Base jsonLd={[websiteLd, softwareLd, faqLd]}>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-[520px] bg-[radial-gradient(60%_60%_at_50%_0%,rgb(155_77_255/0.10),transparent_70%)]"></div>
    <div class="container-x relative grid items-center gap-16 pb-24 pt-14 md:pt-20 xl:grid-cols-[1.1fr_1fr] xl:gap-10 xl:pb-32">
      <div>
        <a href={url('/platform')} class="inline-flex items-center gap-2 rounded-full border border-line bg-white px-3 py-1.5 text-[13px] font-medium text-ink-soft transition-colors hover:border-[#cfcbc2]">
          <span class="rounded-full bg-brand px-2 py-0.5 text-[11px] font-bold text-white">NEW</span>
          Research · Plan · Create · Publish · Measure
          <span aria-hidden="true">→</span>
        </a>
        <h1 class="mt-6 text-[42px] font-semibold leading-[1.02] tracking-[-0.035em] sm:text-[58px] lg:text-[64px] xl:text-[60px] 2xl:text-[66px]">
          <span class="sm:whitespace-nowrap">Your whole marketing</span><br />
          <span class="sm:whitespace-nowrap">team, <span class="serif-accent text-brand pr-1">in one AI.</span></span>
        </h1>
        <p class="mt-6 max-w-[540px] text-[18px] leading-relaxed text-ink-soft sm:text-[19px]">
          AdMobot is your AI Chief Marketing Officer. It researches your market and competitors, analyzes what customers say, plans your strategy, creates the content, publishes it everywhere and measures what works.{' '}
          <span class="text-ink">One AI CMO instead of an agency and ten tools.</span>
        </p>
        <div class="mt-9" id="early-access-hero">
          <EarlyAccess source="hero" />
        </div>
        <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-[13.5px] text-ink-mute">
          <li class="flex items-center gap-2"><span class="text-royal">✓</span> Plans from ₹1,499/month</li>
          <li class="flex items-center gap-2"><span class="text-royal">✓</span> You approve what goes out</li>
          <li class="flex items-center gap-2"><span class="text-royal">✓</span> Cancel anytime</li>
        </ul>
      </div>
      <HeroMock />
    </div>
  </section>

  <!-- Channels -->
  <section class="border-y border-line bg-white/60">
    <div class="container-x flex flex-col items-center gap-6 py-9 md:flex-row md:justify-between">
      <p class="shrink-0 text-[13px] font-medium text-ink-mute">Publishes to</p>
      <ul class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 md:justify-end">
        {CHANNELS.map((c) => <li class="text-[16px] font-semibold tracking-tight text-ink/70">{c}</li>)}
      </ul>
    </div>
  </section>

  <!-- Problem -->
  <section class="container-x py-24 md:py-32" data-reveal>
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow">The problem</p>
      <h2 class="mt-4 text-[34px] font-semibold leading-tight tracking-[-0.03em] sm:text-[46px]">
        Marketing is ten jobs. <span class="serif-accent">You've been doing all of them.</span>
      </h2>
      <p class="mt-5 text-[18px] leading-relaxed text-ink-soft">
        Research, strategy, copy, design, scheduling, analytics, reviews, experiments. Each comes with its own tool, its own login and its own spreadsheet, and none of them talk to each other. An agency costs a retainer. A freelancer covers one piece.
      </p>
    </div>
    <div class="mt-14 grid gap-5 md:grid-cols-3">
      {
        [
          ['Too many tools', 'A research tool, a scheduler, a design app, analytics, a review dashboard. Paid for separately, stitched together by you.'],
          ['No one owns the plan', 'Posts go out, but nobody connects them to a strategy, to what competitors are doing, or to what customers keep asking for.'],
          ['No feedback loop', 'Likes in one app, clicks in another, installs in a third. Nobody has time to work out what worked and do more of it.'],
        ].map(([t, b]) => (
          <div class="card p-7">
            <h3 class="text-[18px] font-semibold">{t}</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-ink-mute">{b}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- The loop -->
  <section id="how" class="scroll-mt-20 bg-ink text-white">
    <div class="container-x py-24 md:py-32">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow !text-sky">How it works</p>
        <h2 class="mt-4 text-[34px] font-semibold leading-tight tracking-[-0.03em] sm:text-[46px]">
          The complete marketing loop, <span class="serif-accent text-brand">run by one AI.</span>
        </h2>
        <p class="mt-5 text-[17px] leading-relaxed text-white/60">
          Give AdMobot your website. It learns your brand, runs every stage of marketing, and feeds what it measures back into the next plan.
        </p>
      </div>
      <ol class="mt-16 grid gap-px overflow-hidden rounded-[28px] bg-white/10 sm:grid-cols-2 lg:grid-cols-4">
        {
          STAGES.map((s, i) => (
            <li class="bg-ink p-7" data-reveal>
              <div class="flex items-center justify-between">
                <span class="font-serif text-[34px] italic text-white/30">{String(i + 1).padStart(2, '0')}</span>
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="text-sky"><path d={s.icon} /></svg>
              </div>
              <h3 class="mt-5 text-[19px] font-semibold">{s.name}</h3>
              <p class="mt-1 text-[13px] font-medium text-white/45">{s.verb}</p>
              <p class="mt-3 text-[14.5px] leading-relaxed text-white/60">{s.summary}</p>
            </li>
          ))
        }
        <li class="flex flex-col justify-between bg-gradient-to-br from-violet/30 to-royal/30 p-7" data-reveal>
          <p class="font-serif text-[26px] italic leading-snug text-white">…and back to research, a little smarter every week.</p>
          <a href={url('/platform')} class="mt-6 inline-flex items-center gap-1.5 text-[14px] font-semibold text-white">
            See every tool <span aria-hidden="true">→</span>
          </a>
        </li>
      </ol>
    </div>
  </section>

  <!-- Platform -->
  <section id="product" class="container-x scroll-mt-20 py-24 md:py-32">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between" data-reveal>
      <div class="max-w-2xl">
        <p class="eyebrow">Platform</p>
        <h2 class="mt-4 text-[34px] font-semibold leading-tight tracking-[-0.03em] sm:text-[46px]">
          Everything a marketing team does. <span class="serif-accent">One login.</span>
        </h2>
      </div>
      <a href={url('/platform')} class="btn-secondary shrink-0">Explore the platform</a>
    </div>
    <div class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        STAGES.map((s, i) => (
          <a href={url(`/platform#${s.id}`)} class={`card group relative overflow-hidden p-7 transition-transform hover:-translate-y-0.5 ${i === 0 ? 'lg:col-span-2' : ''}`} data-reveal>
            <div class="flex items-center gap-3">
              <span class={`grid h-10 w-10 place-items-center rounded-2xl border border-line bg-white shadow-sm ${tones[i]}`}>
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={s.icon} /></svg>
              </span>
              <div>
                <h3 class="text-[19px] font-semibold tracking-tight">{s.name}</h3>
                <p class="text-[13px] text-ink-mute">{s.verb}</p>
              </div>
            </div>
            <ul class="mt-5 flex flex-wrap gap-2">
              {s.tools.map(([t]) => <li class="rounded-full border border-line bg-paper px-3 py-1 text-[13px] font-medium text-ink-soft">{t}</li>)}
            </ul>
          </a>
        ))
      }
      <div class="card border-dashed !bg-transparent p-7 md:col-span-2" data-reveal>
        <p class="text-[12px] font-bold uppercase tracking-wider text-ink-mute">Coming next</p>
        <ul class="mt-4 grid gap-4 sm:grid-cols-2">
          {COMING_NEXT.map(([t, b]) => (
            <li>
              <p class="text-[15px] font-semibold">{t}</p>
              <p class="mt-0.5 text-[13.5px] leading-relaxed text-ink-mute">{b}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Control -->
  <section class="bg-paper-2/70">
    <div class="container-x py-24 md:py-32">
      <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
        <div data-reveal>
          <p class="eyebrow">You stay in charge</p>
          <h2 class="mt-4 text-[34px] font-semibold leading-tight tracking-[-0.03em] sm:text-[46px]">
            Autopilot when you want it. <span class="serif-accent">A brake when you don't.</span>
          </h2>
          <p class="mt-5 text-[17px] leading-relaxed text-ink-soft">
            Set how much freedom AdMobot has on each channel. Start by approving everything, then let it run the channels you trust. Every action is logged, and one switch pauses it all.
          </p>
        </div>
        <div class="grid gap-4" data-reveal>
          {
            modes.map((m, i) => (
              <div class={`card flex items-start gap-5 p-6 ${i === 1 ? 'ring-2 ring-royal/30' : ''}`}>
                <span class="grid h-10 w-10 shrink-0 place-items-center rounded-2xl bg-brand text-[15px] font-bold text-white">{i + 1}</span>
                <div>
                  <div class="flex flex-wrap items-center gap-2">
                    <h3 class="text-[17px] font-semibold">{m.name}</h3>
                    <span class="rounded-full bg-paper-2 px-2.5 py-0.5 text-[11.5px] font-semibold text-ink-mute">{m.tag}</span>
                  </div>
                  <p class="mt-1.5 text-[15px] leading-relaxed text-ink-mute">{m.body}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Comparison -->
  <section class="container-x py-24 md:py-32" data-reveal>
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow">Compare</p>
      <h2 class="mt-4 text-[34px] font-semibold leading-tight tracking-[-0.03em] sm:text-[46px]">
        The output of a team. <span class="serif-accent">The price of one tool.</span>
      </h2>
    </div>
    <div class="card mt-14 overflow-x-auto">
      <table class="w-full min-w-[720px] text-left text-[14.5px]">
        <thead>
          <tr class="border-b border-line">
            <th class="p-5 font-medium text-ink-mute"></th>
            <th class="p-5"><span class="rounded-full bg-ink px-3 py-1.5 text-[13px] font-semibold text-white">AdMobot</span></th>
            <th class="p-5 font-semibold">Agency</th>
            <th class="p-5 font-semibold">Freelancer</th>
            <th class="p-5 font-semibold">Separate tools</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          {
            compare.map(([label, ...cells]) => (
              <tr>
                <td class="p-5 font-medium">{label}</td>
                {cells.map((c, i) => (
                  <td class={`p-5 ${i === 0 ? 'font-semibold text-ink' : 'text-ink-mute'}`}>
                    {c === 'yes' ? <span class="text-royal">✓</span> : c === 'no' ? <span class="text-ink-mute/60">—</span> : c}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="mt-4 text-center text-[13px] text-ink-mute">
      Want the full breakdown? <a class="font-medium text-royal underline underline-offset-4" href={url('/blog/ai-cmo-vs-agency-vs-freelancer')}>AI CMO vs agency vs freelancer</a>
    </p>
  </section>

  <!-- Built for -->
  <section class="container-x pb-24 md:pb-32">
    <div class="grid gap-5 md:grid-cols-3">
      {
        [
          ['D2C & Shopify brands', 'Competitor watch, campaign and festival plans, and your catalogue turned into posts that sell.', '/for/d2c-brands'],
          ['Startups & apps', 'Positioning, launch plans, app store reviews and listings, tracked installs and growth experiments.', '/for/startups'],
          ['Agencies', 'Run three client brands from one account, each with its own Brand Brain and approval flow.', '/for/agencies'],
        ].map(([t, b, href]) => (
          <a href={url(href)} class="card group p-8 transition-transform hover:-translate-y-0.5" data-reveal>
            <h3 class="text-[20px] font-semibold tracking-tight">{t}</h3>
            <p class="mt-3 text-[15px] leading-relaxed text-ink-mute">{b}</p>
            <span class="mt-6 inline-flex items-center gap-1.5 text-[14px] font-semibold text-royal">
              Learn more <span class="transition-transform group-hover:translate-x-0.5">→</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Pricing -->
  <section id="pricing" class="scroll-mt-20 bg-paper-2/70">
    <div class="container-x py-24 md:py-32">
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <p class="eyebrow">Pricing</p>
        <h2 class="mt-4 text-[34px] font-semibold leading-tight tracking-[-0.03em] sm:text-[46px]">
          Simple plans, <span class="serif-accent">priced for India.</span>
        </h2>
        <p class="mt-4 text-[17px] text-ink-soft">Every plan starts with a 7-day trial. Pay by card or UPI Autopay.</p>
      </div>
      <div class="mt-14" data-reveal>
        <PricingCards />
      </div>
      <p class="mt-8 text-center text-[14px] text-ink-mute">
        {SITE.gstPercent ? 'Prices exclude GST. ' : ''}<a href={url('/pricing')} class="font-medium text-royal underline underline-offset-4">See what credits cover →</a>
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="container-x py-24 md:py-32">
    <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
      <div data-reveal>
        <p class="eyebrow">FAQ</p>
        <h2 class="mt-4 text-[34px] font-semibold leading-tight tracking-[-0.03em] sm:text-[42px]">Questions, answered.</h2>
        <p class="mt-4 text-[16px] text-ink-soft">
          Something else? Write to <a class="text-royal underline underline-offset-4" href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>.
        </p>
      </div>
      <div data-reveal><Faq items={FAQ} /></div>
    </div>
  </section>

  <!-- Final CTA -->
  <section id="early-access" class="container-x scroll-mt-24 pb-24 md:pb-32">
    <div class="relative overflow-hidden rounded-[36px] bg-ink px-6 py-16 text-center text-white sm:px-12 md:py-24" data-dark>
      <div class="glow left-[10%] top-[-30%] h-72 w-72 bg-violet"></div>
      <div class="glow right-[5%] bottom-[-40%] h-72 w-72 bg-sky"></div>
      <div class="relative mx-auto max-w-2xl">
        <h2 class="text-[34px] font-semibold leading-tight tracking-[-0.03em] sm:text-[52px]">
          Hire your AI CMO <span class="serif-accent text-brand">today.</span>
        </h2>
        <p class="mx-auto mt-5 max-w-lg text-[17px] leading-relaxed text-white/65">
          Give it your website this afternoon. Have your research, strategy and first week of content by tonight.
        </p>
        <div class="mt-9 flex justify-center">
          <EarlyAccess source="footer-cta" dark />
        </div>
      </div>
    </div>
  </section>
  <Company />
</Base>
