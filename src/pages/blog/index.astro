---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EarlyAccess from '../../components/EarlyAccess.astro';
import { url } from '../../lib/site';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const fmt = (d: Date) => d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
const [first, ...rest] = posts;
---

<Base title="Blog — marketing playbooks for founders" description="Practical marketing playbooks for Indian startups and D2C brands: content plans, Instagram, LinkedIn, and how to get marketing done without a big team.">
  <section class="container-x pb-10 pt-16 md:pt-24">
    <p class="eyebrow">Blog</p>
    <h1 class="mt-4 max-w-3xl text-[42px] font-semibold leading-[1.05] tracking-[-0.035em] sm:text-[58px]">
      Marketing playbooks <span class="serif-accent text-brand">for founders who build.</span>
    </h1>
  </section>

  <section class="container-x pb-24">
    {
      first && (
        <a href={url(`/blog/${first.id}`)} class="card group grid gap-8 overflow-hidden p-8 md:grid-cols-[1.2fr_1fr] md:p-12">
          <div>
            <p class="text-[13px] font-semibold text-royal">
              {first.data.category} · {first.data.readMinutes} min read
            </p>
            <h2 class="mt-4 text-[28px] font-semibold leading-tight tracking-[-0.025em] group-hover:text-royal sm:text-[34px]">{first.data.title}</h2>
            <p class="mt-4 text-[16px] leading-relaxed text-ink-soft">{first.data.description}</p>
            <p class="mt-6 text-[13px] text-ink-mute">{fmt(first.data.date)}</p>
          </div>
          <div class="relative hidden min-h-[220px] overflow-hidden rounded-3xl bg-ink md:block">
            <div class="glow left-[10%] top-[10%] h-40 w-40 bg-violet" />
            <div class="glow bottom-[5%] right-[5%] h-40 w-40 bg-sky" />
            <span class="absolute bottom-6 left-6 font-serif text-[40px] italic leading-none text-white/90">Read →</span>
          </div>
        </a>
      )
    }

    <div class="mt-6 grid gap-6 md:grid-cols-2">
      {
        rest.map((p) => (
          <a href={url(`/blog/${p.id}`)} class="card group flex flex-col p-8">
            <p class="text-[13px] font-semibold text-royal">
              {p.data.category} · {p.data.readMinutes} min read
            </p>
            <h2 class="mt-3 text-[22px] font-semibold leading-snug tracking-[-0.02em] group-hover:text-royal">{p.data.title}</h2>
            <p class="mt-3 text-[15px] leading-relaxed text-ink-mute">{p.data.description}</p>
            <p class="mt-auto pt-6 text-[13px] text-ink-mute">{fmt(p.data.date)}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section id="early-access" class="container-x scroll-mt-24 pb-24 text-center">
    <h2 class="text-[30px] font-semibold tracking-[-0.03em] sm:text-[40px]">Rather have it done for you?</h2>
    <p class="mx-auto mt-3 max-w-md text-[16.5px] text-ink-soft">AdMobot plans, writes and publishes your posts. You approve.</p>
    <div class="mt-8 flex justify-center"><EarlyAccess source="blog-index" /></div>
  </section>
</Base>
